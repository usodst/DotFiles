{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "Azure": {
        "type": "local",
        "command": ["npx", "-y", "@azure/mcp@latest", "server", "start"],
        "disabled": false
      },
      "AzureDevOps": {
        "type": "local",
        "command": ["npx", "-y", "@azure-devops/mcp", ""],
        "disabled": false
      },
      "Playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest", "--save-session"],
        "disabled": false
      }
    }
  },
  "providers": {
    "ollama": {
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:30b": {
          "name": "Qwen3",
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true
            }
          }
        }
      }
    }
  }
}
