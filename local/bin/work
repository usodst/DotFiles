#!/bin/bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/source/repos/ -mindepth 1 -maxdepth 1 -type d -not -path . | fzf --layout=reverse)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected nvim \; new-window -d \; new-window -d lazygit
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected nvim
    tmux switch-client -t $selected_name \; new-window -d -c $selected \; new-window -d -c $selected lazygit
fi

tmux switch-client -t $selected_name
